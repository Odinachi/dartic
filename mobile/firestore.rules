rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ── Data Structures course: signed-in users only, read-only ──
    // Content is written by scripts/upload_dsa_course (Admin SDK, which
    // bypasses these rules), so clients never need write access.
    match /DSA_course/{lessonId} {
      allow read: if signedIn();
      allow write: if false;

      // content/main and quiz/main
      match /{subcollection}/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /DSA_course_modules/{moduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Algorithm practice problems ──
    match /DSA/{problemId} {
      allow read: if signedIn();
      allow write: if false;

      match /problem/{docId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Solutions are paid for with gems: readable only once this problem
      // is in the reader's wallet.unlocked list.
      match /solution/{docId} {
        allow read: if signedIn() && problemId in get(
            /databases/$(database)/documents/Users/$(request.auth.uid)/wallet/main
          ).data.unlocked;
        allow write: if false;
      }
    }

    // ── Gem purchases (RevenueCat webhook, written with the Admin SDK) ──
    match /Purchases/{purchaseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── User profiles and progress (existing) ──
    match /Users/{userId} {
      // Signed-in users can read profiles: the username availability check
      // queries other users' documents by `username`.
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      match /progress/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // ── Gem wallet: { gems, unlocked: [problemId], rewarded: [problemId] } ──
      // Numbers must match GemRules in lib/features/wallet/models/wallet_model.dart.
      match /wallet/{docId} {
        allow read: if isOwner(userId);

        // Created once, with the welcome bonus and nothing unlocked.
        allow create: if isOwner(userId) && docId == 'main'
          && request.resource.data.keys().hasOnly(['gems', 'unlocked', 'rewarded', 'createdAt'])
          && request.resource.data.gems == 3
          && request.resource.data.unlocked.size() == 0
          && request.resource.data.rewarded.size() == 0;

        // The only client move: spend 1 gem to unlock one problem. Gems are
        // added only by the server (purchases, via the Admin SDK).
        allow update: if isOwner(userId) && docId == 'main'
          && request.resource.data.keys().hasOnly(['gems', 'unlocked', 'rewarded', 'createdAt'])
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && spendsOneGem();

        // Allowed so account deletion can remove it.
        allow delete: if isOwner(userId);

        function addedOne(field) {
          let added = request.resource.data[field].removeAll(resource.data[field]);
          return request.resource.data[field].size() == resource.data[field].size() + 1
            && request.resource.data[field].hasAll(resource.data[field])
            && added.size() == 1
            && exists(/databases/$(database)/documents/DSA/$(added[0]));
        }

        function spendsOneGem() {
          return resource.data.gems >= 1
            && request.resource.data.gems == resource.data.gems - 1
            && request.resource.data.rewarded == resource.data.rewarded
            && addedOne('unlocked');
        }
      }
    }
  }
}
