# Copy to .env for local testing (never commit .env). Set the same values in
# the Vercel project: Settings -> Environment Variables.

# RevenueCat secret API key (Project settings -> API keys -> Secret keys,
# starts with sk_). Used by /api/gems/sync to read purchases. Never put it in
# the app.
REVENUECAT_SECRET_KEY=

# Only needed if you use the webhook (paid RevenueCat plans):
# Authorization header value you configure on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=change-me-to-a-long-random-string

# Optional: RevenueCat webhook signing secret (enables HMAC checks).
REVENUECAT_WEBHOOK_SECRET=

# Firebase service account JSON (Project settings -> Service accounts ->
# Generate new private key), pasted as one line.
FIREBASE_SERVICE_ACCOUNT=

FIREBASE_PROJECT_ID=dartcoder-d57cb
